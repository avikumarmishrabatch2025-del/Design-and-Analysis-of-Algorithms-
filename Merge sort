#include <stdio.h>
#include <stdlib.h>

void merge(int a[], int l, int m, int r) {
    //write your code here..
	int i = l, j = m + 1, k = 0;
	int temp[1000];

	while (i <= m && j <= r)
	{
	if (a[i] <= a[j])
		temp[k++] = a[i++];
	else
		temp[k++] = a[j++];
	}

	while (i <= m)
		temp[k++] = a[i++];

	while (j <= r)
		temp[k++] = a[j++];

	for (i = l, k = 0; i <= r; i++, k++)
		a[i] = temp[k];
    
    
    
}

void mergeSort(int a[], int l, int r) {
    //write your code here..
	if (l < r)
	{
		int m = (l + r) / 2;
		mergeSort(a, l, m);
		mergeSort(a, m + 1, r);
		merge(a, l, m, r);
	}
    
    
    
}

int main() {
    int n;
    scanf("%d", &n);

    int *arr = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    mergeSort(arr, 0, n - 1);

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    free(arr);
    return 0;
}
